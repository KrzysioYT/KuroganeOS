# Auto detect text files and perform LF normalization
* text=auto

# Unix/WSL build entry points must never be checked out with CRLF. Bash reads
# a trailing CR as part of tokens such as `pipefail`, which makes an otherwise
# valid script fail immediately on Windows+WSL. Keep these canonical on every
# host regardless of core.autocrlf.
*.sh text eol=lf
Makefile text eol=lf
*.mk text eol=lf
*.iso filter=lfs diff=lfs merge=lfs -text
*.img filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
/tools/compiler/x86_64-elf/bin/x86_64-elf-gdb.exe filter=lfs diff=lfs merge=lfs -text
/tools/compiler/x86_64-elf/bin/x86_64-elf-lto-dump.exe filter=lfs diff=lfs merge=lfs -text
/tools/compiler/x86_64-elf/libexec/gcc/x86_64-elf/15.2.0/cc1.exe filter=lfs diff=lfs merge=lfs -text
/tools/compiler/x86_64-elf/libexec/gcc/x86_64-elf/15.2.0/cc1plus.exe filter=lfs diff=lfs merge=lfs -text
/tools/compiler/x86_64-elf/libexec/gcc/x86_64-elf/15.2.0/lto1.exe filter=lfs diff=lfs merge=lfs -text
/tools/qemu/share/edk2-aarch64-code.fd filter=lfs diff=lfs merge=lfs -text
/tools/qemu/share/edk2-arm-code.fd filter=lfs diff=lfs merge=lfs -text
/tools/qemu/share/edk2-arm-vars.fd filter=lfs diff=lfs merge=lfs -text
