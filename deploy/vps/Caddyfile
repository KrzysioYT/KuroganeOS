{
    admin off
}

(common_headers) {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
}

{$PORTAL_HOST} {
    import common_headers

    handle /healthz {
        respond "kuroganeos portal ok\n" 200
    }

    handle {
        root * /srv/site
        try_files {path} {path}/ /index.html
        file_server
    }
}

{$DOCS_HOST} {
    import common_headers

    handle /healthz {
        respond "kuroganeos docs ok\n" 200
    }

    handle {
        root * /srv/site/docs
        try_files {path} {path}/ /index.html
        file_server
    }
}

{$PACKAGES_HOST} {
    import common_headers
    header Access-Control-Allow-Origin "*"
    header Cache-Control "public, max-age=60"

    handle /healthz {
        respond "kuroganeos packages ok\n" 200
    }

    @gitmeta path /.git* /.github/*
    handle @gitmeta {
        respond 404
    }

    # Compatibility with the raw.githubusercontent.com base currently used by Anvil.
    handle_path /KrzysioYT/KuroganeOS-Packages/main/* {
        root * /srv/packages
        file_server
    }

    # Native Anvil mirror layout.
    handle {
        root * /srv/packages
        file_server
    }
}
